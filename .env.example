# 复制为 .env 后按需修改：cp .env.example .env
COMPOSE_PROJECT_NAME=quality-trace
BACKEND_PORT=21114
DB_PORT=54320
DB_USER=app_user
DB_PASSWORD=app_password
DB_NAME=app_db

# 认证
JWT_SECRET=local-dev-secret
JWT_TTL_MILLIS=28800000

# 调查包导出：演示环境默认开启「模拟分片失败」以演示断点续传
PACKAGE_EXPORT_SIMULATE_FAILURE=true
PACKAGE_EXPORT_FAIL_ON_SHARD=3
PACKAGE_EXPORT_MAX_RETRY=3
PACKAGE_EXPORT_SHARD_SIZE=200

# 限流
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MILLIS=60000
